# Stopping power of alpha particles, 100 eV to 400 MeV in liquid water with Geant4-DNA
# dna_opt4 (stationary mode), compared with ICRU 90.
# Validation macro, run unchanged by the CI (no /control/execute, loops or
# aliases). One /run/beamOn per energy: Run::EndOfRun appends one line per
# run to spower.txt, read by validation/parser.py.
/control/verbose 2
/run/verbose 1
/run/numberOfThreads 4
/random/setSeeds 12345 67890
#
/spower/det/setMat G4_WATER
/spower/det/setRadius 1 m
/spower/phys/addPhysics dna_opt4
#
/run/initialize
/run/printProgress 0
#
/gun/particle alpha
#
/gun/energy 100 eV 
/run/beamOn 100
#
/gun/energy 200 eV
/run/beamOn 100
#
/gun/energy 300 eV 
/run/beamOn 100
#
/gun/energy 400 eV 
/run/beamOn 100
#
/gun/energy 500 eV 
/run/beamOn 100
#
/gun/energy 600 eV 
/run/beamOn 100
#
/gun/energy 700 eV 
/run/beamOn 100
#
/gun/energy 800 eV 
/run/beamOn 100
#
/gun/energy 900 eV 
/run/beamOn 100
