# Stopping power of electrons, 10 eV to 200 keV in liquid water with Geant4-DNA
# dna_opt2 (stationary mode), compared with ICRU 90.
# Validation macro, run unchanged by the CI (no /control/execute, loops or
# aliases). One /run/beamOn per energy: Run::EndOfRun appends one line per
# run to spower.txt, read by validation/parser.py.
/control/verbose 2
/run/verbose 1
/run/numberOfThreads 4
/random/setSeeds 12345 67890
#
/spower/det/setMat G4_WATER
/spower/det/setRadius 1 m
/spower/phys/addPhysics dna_opt6
#
/run/initialize
/run/printProgress 0
#
/gun/particle e-
#
/gun/energy 10 eV
/run/beamOn 10000
#
/gun/energy 15 eV
/run/beamOn 10000
#
/gun/energy 20 eV
/run/beamOn 10000
#
/gun/energy 30 eV
